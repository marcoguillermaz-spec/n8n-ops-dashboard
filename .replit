run = "HOSTNAME=0.0.0.0 node .next/standalone/server.js"

[deployment]
run = ["sh", "-c", "HOSTNAME=0.0.0.0 node .next/standalone/server.js"]
build = ["sh", "-c", "npm install && npm run build && cp -r .next/static .next/standalone/.next/static && cp -r certs .next/standalone/certs"]

[nix]
channel = "stable-24_05"

[languages.javascript]
pattern = "**/*.{js,jsx,ts,tsx}"

  [languages.javascript.languageServer]
  start = "typescript-language-server --stdio"
